# =============================================================================
# BudgetBot — Cấu hình môi trường Local (ĐATN)
# =============================================================================

# ----- AI Backend -----
# Options: local | nlp_ml
AI_BACKEND=local

# ----- Lưu trữ file cục bộ (Object Storage) -----
# Options: local
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./_data/uploads

# ----- Cơ sở dữ liệu giao dịch (PostgreSQL 15 Local) -----
# Options: postgres | sqlite
USERSTORE_BACKEND=postgres
USERSTORE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/budgetbot
USERSTORE_SQLITE_PATH=./_data/transactions.db

# ----- Định danh & Xác thực (Identity & Auth) -----
DEFAULT_USER_ID=test-user-001
JWT_SECRET=supersecret
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60

# ----- Cấu hình Server & Frontend -----
SERVE_FRONTEND=true
CORS_ORIGINS=*
LOG_LEVEL=INFO
